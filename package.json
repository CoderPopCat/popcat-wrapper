{
	"name": "popcat-wrapper",
	"version": "1.6.0",
	"description": "An API wrapper for the Pop Cat API to make your life easier while using it!",
	"homepage": "https://api.popcat.xyz",
	"keywords": [
		"image generation",
		"discord.js",
		"discord welcome card",
		"pop cat"
	],
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"exports": {
		".": {
			"require": "./dist/index.cjs",
			"import": "./dist/index.mjs"
		}
	},
	"scripts": {
		"format": "prettier -w .",
		"test": "jest",
		"build": "tsdown"
	},
	"author": "Pop Cat",
	"license": "ISC",
	"dependencies": {
		"axios": "^1.13.4"
	},
	"devDependencies": {
		"jest": "^30.2.0",
		"prettier": "^3.8.1",
		"tsdown": "^0.20.1"
	}
}
